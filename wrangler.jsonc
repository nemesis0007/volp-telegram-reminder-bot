{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "volp-telegram-reminder-bot",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-26",
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "vars": {
    "TELEMETRY_DISABLED": "false"
  },
  "secrets": {
    "required": [
      "TELEGRAM_BOT_TOKEN",
      "WEBHOOK_SECRET",
      "CREDENTIAL_KEY"
    ]
  },
  "queues": {
    "producers": [
      {
        "binding": "SYNC_QUEUE",
        "queue": "volp-sync-jobs"
      }
    ],
    "consumers": [
      {
        "queue": "volp-sync-jobs",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "retry_delay": 300,
        "max_concurrency": 3
      }
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "volp-reminder-bot",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ]
}
